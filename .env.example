# SQLite database file (relative to prisma/schema.prisma).
# To use Postgres later: change the provider in prisma/schema.prisma and set a postgres:// URL.
DATABASE_URL="file:./dev.db"

# Admin login for /admin
ADMIN_EMAIL="admin@example.com"

# Generate with: npm run hash-password -- "your-password"
# Every "$" in the hash must be escaped as "\$".
ADMIN_PASSWORD_HASH=""

# Optional, for local development only: plain-text password used when ADMIN_PASSWORD_HASH is empty.
ADMIN_PASSWORD="change-me"

# Random string of at least 32 characters used to sign admin sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string-of-at-least-32-chars"
